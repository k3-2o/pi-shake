{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "node": true
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["warn", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_" }],
    "typescript-eslint/no-unused-vars": [
      "warn",
      { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_" }
    ],
    "oxc/no-map-spread": "off" // intentional object spreads in map() — readability over micro-perf
  },
  "ignorePatterns": ["node_modules/", "bun.lock", "test/m3b.test.ts.expect"]
}
